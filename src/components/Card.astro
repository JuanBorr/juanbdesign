---
import { Image } from 'astro:assets'

interface Props {
  title: string
  description?: string
  image: ImageMetadata
  href: string
  index?: string
  category?: string
  placement?: 'feature-left' | 'tall-right' | 'small-left' | 'wide-right' | 'center' | 'lower-left' | 'lower-right'
  alt?: string
}

const {
  href,
  title,
  description,
  image,
  index,
  category = description,
  placement = 'center',
  alt = title
} = Astro.props
---

<li class:list={['project-card', placement]} data-reveal>
  <a href={href} target="_blank" rel="noreferrer">
    <div class="project-image">
      <Image src={image} alt={alt} quality="mid" loading="lazy" />
    </div>
    <div class="project-info">
      {index && <span class="project-index">{index}</span>}
      <h2>{title}</h2>
      {category && <p>{category}</p>}
    </div>
  </a>
</li>

<style>
  .project-card { list-style: none; }
  .project-card a { display: block; color: inherit; text-decoration: none; }
  .feature-left { grid-column: 1 / span 7; }
  .tall-right { grid-column: 9 / -1; margin-top: 150px; }
  .small-left { grid-column: 1 / span 5; }
  .wide-right { grid-column: 7 / -1; margin-top: -20px; }
  .center { grid-column: 4 / span 6; }
  .lower-left { grid-column: 1 / span 5; }
  .lower-right { grid-column: 7 / span 5; margin-top: 64px; }

  .project-image {
    position: relative;
    overflow: hidden;
    border: 2px solid var(--ink);
    background: #d0d2cc;
  }

  .project-image::after {
    content: "";
    position: absolute;
    inset: 0;
    border: 10px solid transparent;
    transition: border-color 220ms ease;
    pointer-events: none;
  }

  .project-image :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 600ms cubic-bezier(.16, 1, .3, 1), filter 300ms ease;
  }

  .tall-right .project-image :global(img),
  .small-left .project-image :global(img) { aspect-ratio: 3 / 4; }

  a:hover .project-image::after { border-color: var(--accent); }
  a:hover .project-image :global(img) { transform: scale(1.035); filter: contrast(1.06); }
  a:active .project-image :global(img) { transform: scale(1.01); }

  .project-info {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 8px 18px;
    padding-top: 14px;
    border-top: 2px solid var(--ink);
    margin-top: 14px;
  }

  .project-index {
    grid-row: 1 / span 2;
    color: var(--accent);
    font-size: 0.86rem;
    font-weight: 950;
  }

  h2 {
    margin: 0;
    font-size: clamp(1.3rem, 2.2vw, 2rem);
    font-weight: 950;
    letter-spacing: -0.04em;
    line-height: 0.95;
    text-transform: uppercase;
  }

  p {
    grid-column: 2;
    margin: 0;
    color: var(--muted);
    font-size: 0.8rem;
    font-weight: 700;
  }

  @media (max-width: 860px) {
    .feature-left { grid-column: 1 / span 8; }
    .tall-right { grid-column: 9 / -1; margin-top: 90px; }
    .small-left { grid-column: 1 / span 5; }
    .wide-right { grid-column: 6 / -1; margin-top: 0; }
    .center { grid-column: 3 / span 8; }
    .lower-left { grid-column: 1 / span 5; }
    .lower-right { grid-column: 6 / -1; margin-top: 48px; }
  }

  @media (max-width: 640px) {
    .project-card { grid-column: auto; margin-top: 0; }
    .project-image :global(img),
    .tall-right .project-image :global(img),
    .small-left .project-image :global(img) { aspect-ratio: 4 / 3; }
    .project-info { grid-template-columns: 30px 1fr; }
  }
</style>
