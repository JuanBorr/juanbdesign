---
import Layout from '../layouts/Layout.astro'
import Card from '../components/Card.astro'
import { projects, projectUrl } from '../data/projects'
---

<Layout title="Proyectos | Juan Borrero" description="Selección de proyectos de diseño gráfico, editorial y web de Juan Borrero.">
  <main class="page-shell frame">
    <header class="page-header" data-reveal>
      <h1 class="page-title">Proyectos</h1>
      <p class="page-intro">Una selección de proyectos donde la tipografía, la imagen y la interacción construyen una idea reconocible.</p>
    </header>

    <ul class="project-grid" role="list">
      {projects.map((project) => (
        <Card
          index={project.number}
          title={project.title}
          category={project.category}
          alt={project.alt}
          image={project.cover}
          placement="center"
          variant="grid"
          href={projectUrl(project)}
        />
      ))}
    </ul>
  </main>
</Layout>

<style>
  .page-header { margin-bottom: clamp(72px, 12vw, 150px); }
  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(48px, 6vw, 84px) 24px;
    align-items: start;
    margin: 0;
    padding: 0;
  }

  @media (max-width: 860px) {
    .project-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 640px) {
    .project-grid { grid-template-columns: 1fr; gap: 58px; }
  }
</style>
