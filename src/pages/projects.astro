---
import Layout from '../layouts/Layout.astro'
import Card from '../components/Card.astro'
import revista from '../assets/projects/revista.jpg'
import poster from '../assets/projects/poster.jpg'
import pagina from '../assets/projects/web.jpg'
import japan from '../assets/projects/japanese.jpg'
import choco from '../assets/projects/choco.jpg'
---

<Layout title="Proyectos | Juan Borrero" description="Selección de proyectos de diseño gráfico, editorial y web de Juan Borrero.">
  <main class="page-shell frame">
    <header class="page-header" data-reveal>
      <h1 class="page-title">Proyectos</h1>
      <p class="page-intro">Una selección de proyectos donde la tipografía, la imagen y la interacción construyen una idea reconocible.</p>
    </header>

    <ul class="project-grid" role="list">
      <Card index="01" title="Revista de Venus" category="Diseño editorial y dirección de arte" alt="Portada de la Revista Venus" image={revista} placement="feature-left" href="https://www.behance.net/gallery/179763757/Revista-Venus" />
      <Card index="02" title="Silent Hill" category="Concepto visual y póster" alt="Póster conceptual de Silent Hill" image={poster} placement="tall-right" href="https://www.behance.net/gallery/179766499/Concepto-poster-Silent-Hill" />
      <Card index="03" title="Diseño de Portafolio" category="Interfaz y experiencia web" alt="Diseño de portafolio web con estética tecnológica" image={pagina} placement="small-left" href="https://www.behance.net/gallery/161188549/Portfolio-Design" />
      <Card index="04" title="Japanese Street" category="Tipografía y composición" alt="Póster inspirado en cultura urbana japonesa" image={japan} placement="wide-right" href="https://www.behance.net/gallery/181305745/Japanese-street-poster" />
      <Card index="05" title="Chocolicious" category="Identidad y landing page" alt="Landing page de Chocolicious" image={choco} placement="center" href="https://www.behance.net/gallery/181383799/Chocoliciuos" />
    </ul>
  </main>
</Layout>

<style>
  .page-header { margin-bottom: clamp(72px, 12vw, 150px); }
  .project-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(48px, 8vw, 110px) 20px;
    align-items: start;
    margin: 0;
    padding: 0;
  }

  @media (max-width: 640px) {
    .project-grid { grid-template-columns: 1fr; gap: 58px; }
  }
</style>
