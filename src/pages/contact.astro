---
import Layout from '../layouts/Layout.astro'
---

<Layout title="Contáctame | Juan Borrero" description="Contacto para proyectos y colaboraciones con Juan Borrero.">
  <main class="page-shell frame">
    <header class="contact-header" data-reveal>
      <h1>Hablemos.</h1>
      <p>Cuéntame qué quieres crear, para quién y qué debería lograr.</p>
    </header>

    <div class="contact-layout">
      <aside data-reveal>
        <p>También puedes escribirme directamente:</p>
        <a href="mailto:juanbdesign@gmail.com">juanbdesign@gmail.com</a>
        <div class="socials">
          <a href="https://behance.net/juanbdesign" target="_blank" rel="noreferrer">Behance</a>
          <a href="https://instagram.com/juanbdesign" target="_blank" rel="noreferrer">Instagram</a>
          <a href="https://github.com/juanborr" target="_blank" rel="noreferrer">GitHub</a>
        </div>
      </aside>

      <form action="/contact" method="POST" data-reveal>
        <label for="name">
          <span>Nombre</span>
          <input type="text" id="name" name="name" maxlength="50" autocomplete="name" required />
        </label>
        <label for="email">
          <span>Email</span>
          <input type="email" id="email" name="email" autocomplete="email" required />
        </label>
        <label for="message">
          <span>Mensaje</span>
          <textarea rows="6" id="message" name="message" required></textarea>
        </label>
        <button type="submit">Enviar mensaje</button>
      </form>
    </div>
  </main>
</Layout>

<style>
  .contact-header { margin-bottom: clamp(64px, 10vw, 120px); }

  h1 {
    margin: 0;
    color: var(--accent);
    font-size: clamp(5rem, 16vw, 14rem);
    font-weight: 950;
    letter-spacing: -0.095em;
    line-height: 0.68;
    text-transform: uppercase;
  }

  .contact-header p { max-width: 36ch; margin: 46px 0 0; padding-top: 18px; border-top: 2px solid var(--ink); color: var(--muted); font-size: 1.1rem; font-weight: 700; }

  .contact-layout {
    display: grid;
    grid-template-columns: minmax(260px, .7fr) minmax(0, 1.3fr);
    gap: clamp(54px, 10vw, 150px);
    align-items: start;
  }

  aside { padding-top: 22px; border-top: 2px solid var(--ink); }
  aside p { margin: 0 0 16px; color: var(--muted); font-weight: 700; }
  aside > a { font-size: clamp(1rem, 2vw, 1.4rem); font-weight: 900; overflow-wrap: anywhere; text-underline-offset: 5px; }
  .socials { display: flex; flex-wrap: wrap; gap: 18px; margin-top: 38px; }
  .socials a { min-height: 44px; display: inline-flex; align-items: center; font-size: .78rem; font-weight: 900; letter-spacing: .05em; text-transform: uppercase; }

  form { display: grid; gap: 28px; }
  label { display: grid; gap: 10px; }
  label span { font-size: .78rem; font-weight: 900; letter-spacing: .07em; text-transform: uppercase; }

  input,
  textarea {
    width: 100%;
    border: 0;
    border-bottom: 2px solid var(--ink);
    border-radius: 0;
    padding: 14px 0;
    color: var(--ink);
    background: transparent;
    font: inherit;
    font-size: 1.15rem;
    resize: vertical;
  }

  button {
    justify-self: start;
    min-height: 58px;
    padding: 16px 28px;
    border: 2px solid var(--ink);
    border-radius: 0;
    color: var(--paper);
    background: var(--ink);
    font: inherit;
    font-size: .86rem;
    font-weight: 900;
    letter-spacing: .06em;
    text-transform: uppercase;
    cursor: pointer;
    transition: color 180ms ease, background 180ms ease, transform 180ms ease;
  }

  button:hover { color: var(--ink); background: var(--accent); }
  button:active { transform: scale(.98); }

  @media (max-width: 700px) {
    h1 { font-size: clamp(3.5rem, 15vw, 5.8rem); }
    .contact-layout { grid-template-columns: 1fr; }
    aside { order: 2; }
    form { order: 1; }
  }
</style>
