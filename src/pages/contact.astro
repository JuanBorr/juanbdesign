---
import Layout from '../layouts/Layout.astro'
---

<Layout title="Contáctame | Juan Borrero" description="Contacto para proyectos y colaboraciones con Juan Borrero.">
  <main class="page-shell frame">
    <header class="contact-header" data-reveal>
      <h1>Hablemos.</h1>
      <p>Cuéntame qué quieres crear, para quién y qué debería lograr.</p>
    </header>

    <div class="contact-layout">
      <aside data-reveal>
        <p>También puedes escribirme directamente:</p>
        <a href="mailto:fernandezborrerojuan@gmail.com">fernandezborrerojuan@gmail.com</a>
        <div class="socials">
          <a href="https://behance.net/juanbdesign" target="_blank" rel="noreferrer">Behance</a>
          <a href="https://instagram.com/juanbdesign" target="_blank" rel="noreferrer">Instagram</a>
          <a href="https://github.com/juanborr" target="_blank" rel="noreferrer">GitHub</a>
        </div>
      </aside>

      <form
        action="https://formsubmit.co/fernandezborrerojuan@gmail.com"
        method="POST"
        data-contact-form
        data-reveal
      >
        <input type="hidden" name="_subject" value="Nuevo mensaje desde el portafolio" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_captcha" value="false" />
        <label class="honey" aria-hidden="true">
          <span>No completar este campo</span>
          <input type="text" name="_honey" tabindex="-1" autocomplete="off" />
        </label>
        <label for="name">
          <span>Nombre</span>
          <input type="text" id="name" name="name" maxlength="50" autocomplete="name" required />
        </label>
        <label for="email">
          <span>Email</span>
          <input type="email" id="email" name="email" autocomplete="email" required />
        </label>
        <label for="message">
          <span>Mensaje</span>
          <textarea rows="5" id="message" name="message" maxlength="1500" required></textarea>
        </label>
        <button type="submit" data-submit-button>Enviar mensaje</button>
        <p class="form-status" data-form-status aria-live="polite"></p>
      </form>
    </div>
  </main>
</Layout>

<style>
  .contact-header { margin-bottom: clamp(64px, 10vw, 120px); }

  h1 {
    margin: 0;
    color: var(--accent);
    font-size: clamp(5rem, 16vw, 14rem);
    font-weight: 950;
    letter-spacing: -0.095em;
    line-height: 0.68;
    text-transform: uppercase;
  }

  .contact-header p { max-width: 36ch; margin: clamp(66px, 8vw, 108px) 0 0; color: var(--muted); font-size: 1.1rem; font-weight: 700; }

  .contact-layout {
    display: grid;
    grid-template-columns: minmax(360px, .85fr) minmax(0, 1.15fr);
    gap: clamp(54px, 8vw, 110px);
    align-items: start;
  }

  aside { padding-top: 0; }
  aside p { margin: 0 0 16px; color: var(--muted); font-weight: 700; }
  aside > a { font-size: clamp(1rem, 2vw, 1.4rem); font-weight: 900; overflow-wrap: anywhere; text-underline-offset: 5px; }
  .socials { display: flex; flex-wrap: wrap; gap: 18px; margin-top: 38px; }
  .socials a { min-height: 44px; display: inline-flex; align-items: center; font-size: .78rem; font-weight: 900; letter-spacing: .05em; text-transform: uppercase; }

  form { display: grid; gap: 28px; }
  label { display: grid; gap: 10px; }
  label span { font-size: .78rem; font-weight: 900; letter-spacing: .07em; text-transform: uppercase; }
  .honey { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }

  input,
  textarea {
    width: 100%;
    border: 0;
    border-bottom: 2px solid var(--ink);
    border-radius: 0;
    padding: 14px 0;
    color: var(--ink);
    background: transparent;
    font: inherit;
    font-size: 1.15rem;
    resize: vertical;
  }

  button {
    justify-self: start;
    min-height: 58px;
    padding: 16px 28px;
    border: 2px solid var(--ink);
    border-radius: 0;
    color: var(--paper);
    background: var(--ink);
    font: inherit;
    font-size: .86rem;
    font-weight: 900;
    letter-spacing: .06em;
    text-transform: uppercase;
    cursor: pointer;
    transition: color 180ms ease, background 180ms ease, transform 180ms ease;
  }

  button:hover { color: var(--ink); background: var(--accent); }
  button:active { transform: scale(.98); }
  button:disabled { cursor: wait; opacity: .68; }

  .form-status {
    min-height: 1.4em;
    margin: -10px 0 0;
    color: var(--muted);
    font-weight: 800;
  }

  .form-status[data-state="success"] { color: #28703d; }
  .form-status[data-state="error"] { color: #a52d1f; }

  @media (max-width: 900px) {
    h1 { font-size: clamp(3.5rem, 15vw, 5.8rem); }
    .contact-layout { grid-template-columns: 1fr; }
    aside { order: 2; }
    form { order: 1; }
  }
</style>

<script>
  const setupContactForm = () => {
    const form = document.querySelector<HTMLFormElement>('[data-contact-form]')
    if (!form || form.dataset.ready === 'true') return

    const button = form.querySelector<HTMLButtonElement>('[data-submit-button]')
    const status = form.querySelector<HTMLElement>('[data-form-status]')
    if (!button || !status) return

    form.dataset.ready = 'true'

    form.addEventListener('submit', async (event) => {
      event.preventDefault()
      if (!form.reportValidity()) return

      const originalLabel = button.textContent
      button.disabled = true
      button.textContent = 'Enviando...'
      status.dataset.state = 'loading'
      status.textContent = 'Enviando tu mensaje...'

      try {
        const fields = Object.fromEntries(new FormData(form).entries())
        const response = await fetch('https://formsubmit.co/ajax/fernandezborrerojuan@gmail.com', {
          method: 'POST',
          headers: {
            Accept: 'application/json',
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(fields)
        })

        if (!response.ok) throw new Error('FormSubmit rejected the request')

        form.reset()
        status.dataset.state = 'success'
        status.textContent = 'Mensaje enviado. Te responderé lo antes posible.'
      } catch {
        status.dataset.state = 'error'
        status.textContent = 'No se pudo enviar. Inténtalo de nuevo o escríbeme directamente.'
      } finally {
        button.disabled = false
        button.textContent = originalLabel
      }
    })
  }

  setupContactForm()
  document.addEventListener('astro:page-load', setupContactForm)
</script>
